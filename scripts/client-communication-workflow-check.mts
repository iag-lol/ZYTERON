import fs from 'node:fs';import assert from 'node:assert/strict';import {randomUUID} from 'node:crypto';
const config=JSON.parse(fs.readFileSync(process.env.ZYTERON_AUDIT_CONFIG||'../../.tools/admin-audit-private.json','utf8'));if(!config.DATABASE_URL.includes('bwybwrxrbzjkwpxhpkcr'))throw Error('UNEXPECTED_DATABASE');process.env.DATABASE_URL=config.DATABASE_URL;
const {prisma}=await import('../src/lib/prisma');const {publishClientCommunication}=await import('../src/lib/portal/client-communication');
let checks=0;const check=(x:unknown)=>{assert.ok(x);checks++;};
try{await prisma.$transaction(async db=>{const users=await db.$queryRaw<Array<{user_id:string;client_id:string}>>`SELECT l.user_id,l.client_id FROM zyteron_legacy_client_link l JOIN "User" u ON u.id=l.user_id WHERE u.role='CLIENT' AND u."accountStatus"='ACTIVE' AND u."emailVerifiedAt" IS NOT NULL ORDER BY l.client_id LIMIT 2`;const[a,b]=users;assert.ok(a&&b);check(a.client_id!==b.client_id);const key=randomUUID(),input={userId:a.user_id,subject:'TX-QA portal communication',message:'Temporary transaction-only message; no external delivery.'};const before=await db.clientNotification.count({where:{userId:a.user_id}});const one=await publishClientCommunication(input,null,key,db);const two=await publishClientCommunication(input,null,key,db);check(one.id===two.id);check(await db.clientCommunication.count({where:{id:one.id}})===1);check(await db.clientNotification.count({where:{userId:a.user_id}})===before+1);check(await db.clientAuditLog.count({where:{entityId:one.id,action:'ADMIN_COMMUNICATION_SENT'}})===1);await assert.rejects(()=>publishClientCommunication({...input,message:'Different content must be refused.'},null,key,db),/IDEMPOTENCY_CONFLICT/);checks++;
await db.$queryRaw`SELECT set_config('zyteron.portal_user_id',${a.user_id},true)`;await db.$executeRaw`SET LOCAL ROLE zyteron_portal_client`;check((await db.clientCommunication.findMany({where:{id:one.id}})).length===1);await db.$executeRaw`RESET ROLE`;await db.$queryRaw`SELECT set_config('zyteron.portal_user_id',${b.user_id},true)`;await db.$executeRaw`SET LOCAL ROLE zyteron_portal_client`;check((await db.clientCommunication.findMany({where:{id:one.id}})).length===0);await db.$executeRaw`RESET ROLE`;throw new Error('EXPECTED_ROLLBACK');},{timeout:20000});}catch(e){if(!(e instanceof Error)||e.message!=='EXPECTED_ROLLBACK')throw e;}finally{await prisma.$disconnect();}
