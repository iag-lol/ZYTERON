# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/zyteron"

# NextAuth
# Obligatorio. Genera uno distinto por ambiente: openssl rand -base64 48
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Vercel Analytics (optional)
VERCEL_ANALYTICS_ID=""

# OpenAI (asistente de ventas con IA del sitio)
# Crea la key en https://platform.openai.com/api-keys y pégala aquí en Render.
OPENAI_API_KEY=""
# Modelo opcional del chat público. Por defecto: gpt-4o-mini.
OPENAI_MODEL="gpt-4o-mini"
# Modelo opcional del asistente interno del admin (más potente). Por defecto: gpt-4o.
OPENAI_ADMIN_MODEL="gpt-4o"

# Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_QUOTE_BUCKET="quote-documents"

# Public site URL (used by Flow return and PDF links)
NEXT_PUBLIC_SITE_URL="https://www.zyteron.cl"
FLOW_PUBLIC_BASE_URL="https://www.zyteron.cl"

# Flow
FLOW_API_KEY=""
FLOW_SECRET_KEY=""
FLOW_USE_SANDBOX="true"
# FLOW_API_BASE="https://sandbox.flow.cl/api"

# Resend (purchase emails)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Zyteron <noreply@zyteron.cl>"
RESEND_REPLY_TO="contacto@zyteron.cl"
CHECKOUT_ALERT_EMAILS="contacto@zyteron.cl"

# WhatsApp por Meta (Cloud API) para avisos de leads/cotizaciones del chat IA.
# Se configura en https://developers.facebook.com/ (WhatsApp Business Platform).
META_WHATSAPP_TOKEN=""
META_WHATSAPP_PHONE_ID=""
# Número que RECIBE el aviso (tu WhatsApp), formato internacional sin +, ej: 56939526626
META_WHATSAPP_TO=""
# Token secreto de verificación del webhook; debe coincidir con Meta.
WHATSAPP_VERIFY_TOKEN=""
# Webhook para el agente de WhatsApp con IA:
#   Callback URL en Meta = https://TU-DOMINIO/api/whatsapp/webhook
#   Verify Token en Meta = el valor de WHATSAPP_VERIFY_TOKEN

# Correo donde llegan los avisos del chat (además de CHECKOUT_ALERT_EMAILS)
# RESEND_LEAD_TO_EMAIL="contacto@zyteron.cl"

# Twilio WhatsApp (sale alert / respaldo)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_WHATSAPP_TO=""
TWILIO_CONTENT_SID="HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Admin access. Ambos valores son obligatorios y deben ser distintos entre ambientes.
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
COMMERCIAL_SESSION_SECRET=""

# Prisma seed. SEED_ADMIN_PASSWORD es obligatorio al ejecutar `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@zyteron.com"
SEED_ADMIN_PASSWORD=""

# Cifrado y códigos de un solo uso del portal.
PORTAL_SECRET_KEY=""
PORTAL_CODE_PEPPER=""

# Web Push para la app instalable (Mac, Windows, iOS y Android).
# Genera el par una sola vez con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contacto@zyteron.cl"

# SII readiness placeholders
SII_ENVIRONMENT="certificacion"
SII_COMPANY_RUT="78.398.774-0"
SII_COMPANY_NAME="Zyteron SpA"

# ---- Facturación electrónica DTE (FASE 1+). NO poner valores reales aquí ----
# Ambiente: certification | production (por defecto certification)
# SII_ENVIRONMENT="certification"
SII_RUT_EMPRESA=""
SII_RUT_ENVIA=""
# Endpoints oficiales del SII (se definen al integrar la fase 2)
SII_CERTIFICATION_BASE_URL=""
SII_PRODUCTION_BASE_URL=""
# Certificado digital: se carga cifrado vía panel; ruta/almacenamiento seguro
SII_STORAGE_BUCKET="sii-documents"
# Llave para cifrar en reposo la contraseña del certificado (AES-256-GCM). Larga y secreta.
SII_ENCRYPTION_KEY=""
# Operación
SII_STATUS_POLL_INTERVAL="600"
SII_MAX_RETRIES="5"
SII_EMAIL_FROM="facturacion@zyteron.cl"
