// Prisma schema for Zyteron platform
// Stage 1: base models to unblock seeds and future stages

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  firstName    String?
  lastName     String?
  role         Role     @default(CLIENT)
  accountStatus AccountStatus @default(ACTIVE)
  authProvider AuthProvider @default(LOCAL)
  emailVerifiedAt DateTime?
  lastLoginAt  DateTime?
  deactivatedAt DateTime?
  googleId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      String?
  phone        String?
  address      String?
  city         String?
  country      String?  @default("Chile")
  rut          String?
  contactName  String?
  industry     String?
  tier         String?
  notes        String?

  leads       Lead[]
  quotes      Quote[]
  sales       Sale[]
  visits      Visit[]
  sessions    Session[]
  projects    Project[]
  requests    ClientRequest[]
  taxDocuments TaxDocument[]
  workOrders  WorkOrder[]
  verificationCodes EmailVerificationCode[]
  passwordResetCodes PasswordResetCode[]
  credentialRevealCodes CredentialRevealCode[]
  documents ClientDocument[] @relation("ClientDocuments")
  uploadedDocuments ClientDocument[] @relation("ClientDocUploadedBy")
  supportTickets SupportTicket[] @relation("ClientSupportTickets")
  assignedTickets SupportTicket[] @relation("TicketAssignedTo")
  supportMessages SupportTicketMessage[]
  credentials ClientCredential[] @relation("ClientCredentials")
  createdCredentials ClientCredential[] @relation("CredentialCreatedBy")
  updatedCredentials ClientCredential[] @relation("CredentialUpdatedBy")
  notifications ClientNotification[]
  communications ClientCommunication[]
  portalRequests PortalRequest[]
  auditLogs ClientAuditLog[] @relation("AuditActor")
  affectedAuditLogs ClientAuditLog[] @relation("AuditTarget")
}

enum Role {
  SUPERADMIN
  CLIENT
  ADMIN
}

enum AccountStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ServiceCategory {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  order    Int       @default(0)
  services Service[]
}

model Service {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String
  shortCopy   String
  features    String[]
  priceFrom   Int?
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  faqs        FAQ[]
  seoId       String?         @unique
  seo         SeoMetadata?    @relation("ServiceSeo", fields: [seoId], references: [id])
  createdAt   DateTime        @default(now())
}

model ProductCategory {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  order    Int       @default(0)
  products Product[]
}

model Product {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String
  price       Int
  discountPct Int             @default(0)
  stock       Int             @default(10)
  featured    Boolean         @default(false)
  categoryId  String
  category    ProductCategory @relation(fields: [categoryId], references: [id])
  faqs        FAQ[]
  badges      String[]
  seoId       String?         @unique
  seo         SeoMetadata?    @relation("ProductSeo", fields: [seoId], references: [id])
  createdAt   DateTime        @default(now())
}

model Plan {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String
  price       Int
  tier        PlanTier
  freeGifts   String[]
  features    String[]
  popular     Boolean      @default(false)
  quotes      Quote[]
  seoId       String?      @unique
  seo         SeoMetadata? @relation("PlanSeo", fields: [seoId], references: [id])
}

enum PlanTier {
  BASIC
  INTERMEDIATE
  PRO
}

model Extra {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  category    ExtraCategory
  description String
  options     String[]
  price       Int?
  quoteExtras QuoteExtra[]
}

enum ExtraCategory {
  DOMAIN
  EMAIL
  SUPPORT
  EQUIPMENT
  SEO
  DESIGN
  TRAINING
  TECH
}

model Quote {
  id        String       @id @default(cuid())
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  planId    String?
  plan      Plan?        @relation(fields: [planId], references: [id])
  extras    QuoteExtra[]
  name      String
  email     String
  phone     String?
  company   String?
  message   String?
  subtotal  Int
  discount  Int          @default(0)
  total     Int
  status    QuoteStatus  @default(PENDING)
  createdAt DateTime     @default(now())
  taxDocuments TaxDocument[]
  projects   Project[]
  // workOrders WorkOrder[]
}

model QuoteExtra {
  id       String @id @default(cuid())
  quoteId  String
  extraId  String
  quantity Int    @default(1)
  quote    Quote  @relation(fields: [quoteId], references: [id])
  extra    Extra  @relation(fields: [extraId], references: [id])
}

enum QuoteStatus {
  PENDING
  SENT
  WON
  LOST
}

model Lead {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  email     String
  phone     String?
  source    String?
  message   String?
  type      LeadType
  createdAt DateTime @default(now())
}

model WebDiscount {
  id          String             @id @default(cuid())
  name        String
  description String?
  targetType  DiscountTargetType @default(ORDER)
  targetId    String?
  mode        DiscountMode       @default(PERCENT)
  value       Int
  minSubtotal Int?               @default(0)
  active      Boolean            @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model ClientReview {
  id         String       @id @default(cuid())
  name       String
  email      String?
  company    String?
  rating     Int
  comment    String
  service    String?
  status     ReviewStatus @default(PENDING)
  source     String?
  createdAt  DateTime     @default(now())
  approvedAt DateTime?
}

// Blog dinámico administrado desde /admin/blog. El contenido es markdown.
// status usa 'draft' | 'published' (check en la tabla SQL, no enum Prisma).
model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String?
  content         String
  coverImageUrl   String?
  coverImageAlt   String?
  category        String?
  tags            String[]  @default([])
  readMinutes     Int       @default(5)
  author          String    @default("Zyteron")
  status          String    @default("draft")
  metaTitle       String?
  metaDescription String?
  keywords        String?
  ogImageUrl      String?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Casos de éxito administrados desde /admin/casos.
model CaseStudy {
  id              String    @id @default(cuid())
  slug            String    @unique
  companyName     String
  industry        String?
  problem         String
  solution        String
  results         String?
  technologies    String[]  @default([])
  projectDuration String?
  clientQuote     String?
  imageUrl        String?
  imageAlt        String?
  featured        Boolean   @default(false)
  sortOrder       Int       @default(0)
  status          String    @default("draft")
  metaTitle       String?
  metaDescription String?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Visit {
  id        String   @id @default(cuid())
  clientId  String?
  client    User?    @relation(fields: [clientId], references: [id])
  date      DateTime?
  notes     String?
  status    String?
  createdAt DateTime @default(now())
}

model Sale {
  id            String         @id @default(cuid())
  clientId      String?
  client        User?          @relation(fields: [clientId], references: [id])
  total         Int
  description   String?
  paymentMethod String?
  invoiceRef    String?
  createdAt     DateTime       @default(now())
  projects      Project[]
  taxDocuments  TaxDocument[]
  // workOrders    WorkOrder[]
}

model Project {
  id             String          @id @default(cuid())
  clientId       String?
  client         User?           @relation(fields: [clientId], references: [id])
  quoteId        String?
  quote          Quote?          @relation(fields: [quoteId], references: [id])
  saleId         String?
  sale           Sale?           @relation(fields: [saleId], references: [id])
  title          String
  serviceArea    String?
  status         String?
  priority       String?
  startDate      DateTime?
  startTime      String?
  endDate        DateTime?
  endTime        String?
  description    String?
  scope          String?
  hourlyRate     Int?
  estimatedHours Int?
  actualHours    Int?
  totalCharge    Int?
  owner          String?
  createdAt      DateTime        @default(now())
  requests       ClientRequest[]
  taxDocuments   TaxDocument[]
  supportTickets SupportTicket[]
  credentials    ClientCredential[]
}

model WorkOrder {
  id             String   @id @default(cuid())
  code           String   @unique
  source         String   @default("MANUAL_QUOTE")
  status         String   @default("ACTIVE")
  priority       String   @default("NORMAL")
  quoteId        String?
  // quote          Quote?   @relation(fields: [quoteId], references: [id])
  saleId         String?
  // sale           Sale?    @relation(fields: [saleId], references: [id])
  clientId       String?
  client         User?    @relation(fields: [clientId], references: [id])
  title          String
  description    String?
  scope          Json?
  plannedDate    DateTime?
  dueDate        DateTime?
  estimatedHours Int?
  actualHours    Int?
  budget         Int?
  assignedTo     String?
  notes          String?
  pdfUrl         String?
  completedAt    DateTime?
  closedAt       DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ClientRequest {
  id          String   @id @default(cuid())
  clientId    String?
  client      User?    @relation(fields: [clientId], references: [id])
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  subject     String
  channel     String?
  priority    String?
  status      String?
  description String?
  dueDate     DateTime?
  createdAt   DateTime @default(now())
}

model TaxDocument {
  id             String   @id @default(cuid())
  clientId       String?
  client         User?    @relation(fields: [clientId], references: [id])
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id])
  quoteId        String?
  quote          Quote?   @relation(fields: [quoteId], references: [id])
  saleId         String?
  sale           Sale?    @relation(fields: [saleId], references: [id])
  type           String
  documentNumber String?
  siiFolio       String?
  issueDate      DateTime?
  dueDate        DateTime?
  netAmount      Int?
  taxAmount      Int?
  totalAmount    Int?
  status         String?
  paymentStatus  String?
  emissionMethod String?
  pdfUrl         String?
  xmlUrl         String?
  notes          String?
  createdAt      DateTime @default(now())
}

model EmailVerificationCode {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int      @default(0)
  sentCount   Int      @default(1)
  lastSentAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId, email, createdAt])
}

model PasswordResetCode {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int      @default(0)
  sentCount   Int      @default(1)
  lastSentAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId, email, createdAt])
}

model ClientDocument {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("ClientDocuments", fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  category     String
  fileUrl      String
  fileName     String?
  mimeType     String?
  fileSize     Int?
  uploadedById String?
  uploadedBy   User?    @relation("ClientDocUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  isPrivate    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, category, createdAt])
}

model SupportTicket {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("ClientSupportTickets", fields: [userId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title         String
  description   String
  status        String   @default("OPEN")
  priority      String   @default("NORMAL")
  category      String?
  assignedToId  String?
  assignedTo    User?    @relation("TicketAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  messages      SupportTicketMessage[]

  @@index([userId, status, createdAt])
}

model SupportTicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorRole  Role
  message     String
  isInternal  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([ticketId, createdAt])
}

model ClientCredential {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation("ClientCredentials", fields: [userId], references: [id], onDelete: Cascade)
  projectId         String?
  project           Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  serviceName       String
  username          String?
  secretCiphertext  String?
  secretIv          String?
  secretTag         String?
  url               String?
  notes             String?
  isSensitive       Boolean  @default(true)
  createdById       String?
  createdBy         User?    @relation("CredentialCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById       String?
  updatedBy         User?    @relation("CredentialUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, createdAt])
}

model ClientNotification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  body        String
  type        String   @default("INFO")
  link        String?
  isRead      Boolean  @default(false)
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

model ClientCommunication {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  message     String
  direction   String   @default("OUTBOUND")
  channel     String   @default("PORTAL")
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model PortalRequest {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  title          String
  details        String
  attachmentUrl  String?
  attachmentName String?
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, type, status, createdAt])
}

model ClientAuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  actor         User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUserId  String?
  targetUser    User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  action        String
  entityType    String
  entityId      String?
  details       Json?
  createdAt     DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
}

enum LeadType {
  CONTACT
  QUOTE
  PACKAGE_BUILDER
}

enum DiscountTargetType {
  PLAN
  EXTRA
  PRODUCT
  ORDER
}

enum DiscountMode {
  PERCENT
  FIXED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  service   Service? @relation(fields: [serviceId], references: [id])
  serviceId String?
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
  category  String?
  createdAt DateTime @default(now())
}

model SeoMetadata {
  id              String   @id @default(cuid())
  metaTitle       String
  metaDescription String
  slug            String   @unique
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?
  keywords        String[]
  jsonLd          Json?
  noindex         Boolean  @default(false)
  service         Service? @relation("ServiceSeo")
  product         Product? @relation("ProductSeo")
  plan            Plan?    @relation("PlanSeo")
}

model Banner {
  id       String  @id @default(cuid())
  title    String
  body     String
  ctaLabel String?
  ctaHref  String?
  active   Boolean @default(true)
}

model Setting {
  id    String      @id @default(cuid())
  key   String      @unique
  value String
  type  SettingType @default(TEXT)
}

enum SettingType {
  TEXT
  JSON
  BOOLEAN
}

model CredentialRevealCode {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int      @default(0)
  sentCount   Int      @default(1)
  lastSentAt  DateTime @default(now())
}

